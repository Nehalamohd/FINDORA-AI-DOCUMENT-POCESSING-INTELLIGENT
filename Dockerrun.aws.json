{
  "AWSEBDockerrunVersion": 2,
  "containerDefinitions": [
    {
      "name": "postgres",
      "image": "pgvector/pgvector:pg16",
      "essential": true,
      "memory": 256,
      "portMappings": [
        {
          "hostPort": 5432,
          "containerPort": 5432
        }
      ],
      "environment": [
        {
          "name": "POSTGRES_USER",
          "value": "findora"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "findorapass"
        },
        {
          "name": "POSTGRES_DB",
          "value": "findora_db"
        }
      ]
    },
    {
      "name": "redis",
      "image": "redis:latest",
      "essential": true,
      "memory": 128,
      "portMappings": [
        {
          "hostPort": 6379,
          "containerPort": 6379
        }
      ]
    },
    {
      "name": "api",
      "image": "nehala111/findora-api:latest",
      "essential": true,
      "memory": 512,
      "portMappings": [
        {
          "hostPort": 8000,
          "containerPort": 8000
        }
      ],
      "environment": [
        {
          "name": "REDIS_URL",
          "value": "redis://redis:6379/0"
        },
        {
          "name": "DB_HOST",
          "value": "postgres"
        }
      ],
      "links": [
        "postgres",
        "redis"
      ]
    },
    {
      "name": "worker",
      "image": "nehalamohd/findora-api:latest",
      "essential": true,
      "memory": 512,
      "command": [
        "celery",
        "-A",
        "app.celery_app",
        "worker",
        "--loglevel=info"
      ],
      "environment": [
        {
          "name": "REDIS_URL",
          "value": "redis://redis:6379/0"
        },
        {
          "name": "DB_HOST",
          "value": "postgres"
        }
      ],
      "links": [
        "postgres",
        "redis"
      ]
    },
    {
      "name": "frontend",
      "image": "nehala111/findora-frontend:latest",
      "essential": true,
      "memory": 256,
      "portMappings": [
        {
          "hostPort": 80,
          "containerPort": 8501
        }
      ],
      "environment": [
        {
          "name": "API_URL",
          "value": "http://api:8000"
        }
      ],
      "links": [
        "api"
      ]
    }
  ]
}